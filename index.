    container.innerHTML="";

    for(let i=1;i<=60;i++){

        const btn=
            document.createElement("button");

        btn.className="level";

        const completed=
            game.completed.includes(i);

        const unlocked=
            i===1 ||
            game.completed.includes(i-1);

        if(completed){

            btn.classList.add("done");

            btn.innerHTML=
                "✓ "+i;

        }else if(unlocked){

            btn.classList.add("open");

            btn.innerHTML=
                "▶ "+i;

        }else{

            btn.classList.add("locked");

            btn.innerHTML=
                "🔒 "+i;

        }

        if(unlocked){

            btn.onclick=()=>{
                startLevel(i);
            };

        }

        container.appendChild(btn);
    }
}


/* ========================================
   НАЧАЛО УРОВНЯ
======================================== */

function startLevel(level){

    currentLevel=level;

    currentQuestion=0;

    scoreThisLevel=0;

    selectedQuestions=
        getQuestions(level);

    document.getElementById(
        "quizLevelNumber"
    ).textContent=
        "Уровень "+level+" из 60";

    document.getElementById(
        "quizLevelName"
    ).textContent=
        levelNames[level-1];

    document.getElementById(
        "difficulty"
    ).textContent=
        getDifficulty(level);

    showScreen("quizScreen");

    showQuestion();
}


/* ========================================
   СЛОЖНОСТЬ
======================================== */

function getDifficulty(level){

    if(level<=10)
        return "🟢 Beginner";

    if(level<=20)
        return "🔵 Elementary";

    if(level<=30)
        return "🟡 Pre-Intermediate";

    if(level<=40)
        return "🟠 Intermediate";

    if(level<=50)
        return "🔴 Upper-Intermediate";

    return "🟣 Advanced";
}


/* ========================================
   ПОКАЗ ВОПРОСА
======================================== */

function showQuestion(){

    const data=
        selectedQuestions[currentQuestion];

    const total=
        selectedQuestions.length;

    document.getElementById(
        "progressBar"
    ).style.width=
        (currentQuestion/total*100)+"%";

    document.getElementById(
        "question"
    ).textContent=
        data.q;

    const answers=
        document.getElementById(
            "answers"
        );

    answers.innerHTML="";

    document.getElementById(
        "feedback"
    ).textContent="";

    document.getElementById(
        "nextButton"
    ).style.display="none";

    data.a.forEach((answer,index)=>{

        const btn=
            document.createElement(
                "button"
            );

        btn.className="answer";

        btn.textContent=
            String.fromCharCode(65+index)
            +". "
            +answer;

        btn.onclick=()=>{
            checkAnswer(index,btn);
        };

        answers.appendChild(btn);

    });
}


/* ========================================
   ПРОВЕРКА
======================================== */

function checkAnswer(index,button){

    const data=
        selectedQuestions[currentQuestion];

    const all=
        document.querySelectorAll(
            ".answer"
        );

    all.forEach(b=>{
        b.classList.add("disabled");
    });

    if(index===data.c){

        button.classList.add("correct");

        document.getElementById(
            "feedback"
        ).textContent=
            "✅ Правильно! Отлично!";

        scoreThisLevel++;

        game.points+=10;

    }else{

        button.classList.add("wrong");

        all[data.c]
            .classList.add("correct");

        document.getElementById(
            "feedback"
        ).textContent=
            "❌ Неправильно. Правильный ответ: "
            +data.a[data.c];

    }

    document.getElementById(
        "nextButton"
    ).style.display="block";

    updateStats();

    saveGame();
}


/* ========================================
   СЛЕДУЮЩИЙ
======================================== */

function nextQuestion(){

    currentQuestion++;

    if(
        currentQuestion>=
        selectedQuestions.length
    ){

        finishLevel();

    }else{

        showQuestion();

    }
}


/* ========================================
   ЗАВЕРШЕНИЕ УРОВНЯ
======================================== */

function finishLevel(){

    const total=
        selectedQuestions.length;

    const passed=
        scoreThisLevel>=
        Math.ceil(total*.6);

    if(passed){

        if(
            !game.completed.includes(
                currentLevel
            )
        ){

            game.completed.push(
                currentLevel
            );

        }

        const gemBonus=
            10+currentLevel;

        game.gems+=gemBonus;

        game.points+=
            currentLevel*5;

        document.getElementById(
            "resultTitle"
        ).textContent=
            "Уровень пройден! 🎉";

        document.getElementById(
            "resultText"
        ).textContent=
            `Правильных ответов: ${scoreThisLevel} из ${total}.`;

        document.getElementById(
            "resultPoints"
        ).textContent=
            `+${10*scoreThisLevel+
            currentLevel*5} очков`;

        document.getElementById(
            "resultGems"
        ).textContent=
            `+${gemBonus} кристаллов`;

    }else{

        document.getElementById(
            "resultTitle"
        ).textContent=
            "Попробуй ещё раз! 💪";

        document.getElementById(
            "resultText"
        ).textContent=
            `Правильных ответов: ${scoreThisLevel} из ${total}. Нужно минимум 60%.`;

        document.getElementById(
            "resultPoints"
        ).textContent=
            `+${10*scoreThisLevel} очков`;

        document.getElementById(
            "resultGems"
        ).textContent=
            "0";

    }

    saveGame();

    updateStats();

    showScreen("resultScreen");
}


/* ========================================
   ПРОДОЛЖИТЬ
======================================== */

function continueLearning(){

    let next=1;

    while(
        game.completed.includes(next)
        &&
        next<=TOTAL_LEVELS
    ){

        next++;

    }

    if(next>TOTAL_LEVELS){

        alert(
            "🏆 Поздравляю! Ты прошёл все 60 уровней!"
        );

        openLevels();

        return;
    }

    startLevel(next);
}


/* ========================================
   СЕРИЯ
======================================== */

function updateStreak(){

    const today=
        new Date().toDateString();

    if(game.lastDay===today){
        return;
    }

    if(!game.lastDay){

        game.streak=1;

    }else{

        const old=
            new Date(game.lastDay);

        const now=
            new Date();

        const diff=
            Math.floor(
                (now-old)/
                (1000*60*60*24)
            );

        if(diff===1){

            game.streak++;

        }else if(diff>1){

            game.streak=1;

        }

    }

    game.lastDay=today;
}


/* ========================================
   СТАТИСТИКА
======================================== */

function updateStats(){

    document.getElementById(
        "streak"
    ).textContent=
        game.streak||0;

    document.getElementById(
        "gems"
    ).textContent=
        game.gems??50;

    document.getElementById(
        "points"
    ).textContent=
        game.points||0;
}


